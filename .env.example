APP_NAME=Autonomous Multi-Agent Intelligence System
ENVIRONMENT=development
NOTIFY_THRESHOLD=70
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional real-world connectors
GITHUB_TOKEN=
